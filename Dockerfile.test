# Test-only image: installs dev deps and runs pytest.
# Production image uses the regular Dockerfile.

# The uv build tool, digest-pinned — the same reference, in the same shape, as
# the production Dockerfile's `uv` stage. This image exists to exercise what the
# production image ships, so it must not install its tooling by a different
# mechanism. Rationale for the `FROM … AS` form over `COPY --from=<image>`, and
# the digest's provenance, are recorded once in Dockerfile; the two are bumped
# together (the dependency updater sees both, because both are FROM lines).
FROM ghcr.io/astral-sh/uv:0.12.10@sha256:2bb3ebca0a796a155094a27773d290c4b074572e6107f171d88d086682fd2500 AS uv

# The Swiss ephemeris data, fetched and checksum-verified exactly as the
# production Dockerfile does. This image exists to run the suite against REAL
# Swiss data, and it used to get that data from a host bind-mount — so running
# it required a human to have downloaded ~2 MB of licensed binaries out of band
# first (scripts/test-in-docker.* even failed with "Download Swiss Ephemeris
# files first", pointing nowhere). That is the same "supplied out of band, or
# silently not at all" shape as the production defect, one layer down: a
# developer without the files got a green run on the Moshier fallback, because
# the accuracy tests SKIP rather than fail when REQUIRE_SWISS_EPHEMERIS is
# unset. Baking it makes the local Docker loop self-sufficient.
FROM python:3.11-slim AS ephemeris
WORKDIR /fetch
COPY ci/fetch_swiss_ephemeris.py ci/fetch_swiss_ephemeris.py
COPY ci/swiss_ephemeris.json ci/swiss_ephemeris.json
RUN python ci/fetch_swiss_ephemeris.py --self-test \
 && python ci/fetch_swiss_ephemeris.py \
 && python ci/fetch_swiss_ephemeris.py --verify-only

FROM python:3.11-slim

WORKDIR /app

# Install C build tools for pyswisseph compilation
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ make git \
    && rm -rf /var/lib/apt/lists/*

# Install uv itself (matches the production Dockerfile's installer).
COPY --from=uv /uv /uvx /bin/

# CALC-7: install from the committed, hash-pinned lockfile only -- this used
# to be a floating `pip install -e ".[dev]"`, the exact pattern the
# production Dockerfile deliberately moved away from because it ignores
# uv.lock entirely and could pull an unpinned/compromised transitive
# dependency version. `--frozen` fails the build if pyproject.toml and
# uv.lock have drifted, instead of silently re-resolving. This image is what
# scripts/test-in-docker.* runs to exercise real Swiss ephemeris data (see
# CALC-1) -- without this fix that was the one test surface validating a
# different dependency set than what actually ships.
COPY pyproject.toml uv.lock README.md LICENSE EPHEMERIS_LICENSE.md ./
RUN uv sync --frozen --no-install-project --extra dev
ENV PATH="/app/.venv/bin:${PATH}"

COPY bphs_core ./bphs_core
COPY app ./app
COPY tests ./tests

# Second `uv sync --frozen` installs the project itself now that its source
# is present -- still frozen against the same committed lockfile.
RUN uv sync --frozen --extra dev

# The verified data files, from the stage above. No runtime mount: the image
# carries its own data, so `docker compose -f docker-compose.test.yml run test`
# exercises real Swiss values on a machine that has never downloaded anything.
COPY --from=ephemeris /fetch/data/ephe ./data/ephe

# REQUIRE_SWISS_EPHEMERIS=1 turns "the Swiss data is not active" from a SKIP
# into a hard failure in tests/test_swiss_ephemeris.py. Set here rather than
# left to the caller because it is now always true of this image: the data is
# baked in, so a skip could only ever mean the bake broke — precisely the
# regression this image should catch, and precisely what a silent skip hides.
ENV REQUIRE_SWISS_EPHEMERIS=1

CMD ["pytest", "tests/", "-v", "--tb=short"]
